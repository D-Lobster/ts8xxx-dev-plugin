  "hosts": {
    "pi": {
      "instructions": "AGENTS.md",
      "global_skills": "~/.agents/skills",
      "project_skills": [
        "ts800x-workflow",
        "ts800x-coding-standard",
        "ts800x-team-orchestrator",
