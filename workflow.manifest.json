      "extension_source": "adapters/pi/ts800x-workflow-hooks.ts",
      "extension_target": "~/.pi/agent/extensions/ts800x-workflow-hooks.ts"
    },
    "claude": {
      "instructions": "CLAUDE.md",
      "global_skills": "~/.claude/skills",
      "project_adapter": ".claude-plugin"
    },
    "codex": {
      "instructions": "AGENTS.md",
      "global_skills": "~/.codex/skills"
    },
    "powershell": {
      "entry": "workflow.ps1",
      "hook_runner": ".claude-plugin/hooks/run-hook.ps1"
    },
    "deepseek": {
      "instructions": "DEEPSEEK.md",
      "global_skills": "~/.agents/skills",
      "preset_source": "adapters/deepseek/ts8xxx-dev",
      "preset_id": "ts8xxx-dev",
      "preset_patch": "cordis.patch.yml",
      "preset_profiles_root": "~/.dsh/profiles",
      "preset_profile": "desktop"
    },
    "opencode": {
      "instructions": "AGENTS.md",
      "plugin_source": "adapters/opencode/ts800x-workflow",
      "global_config": "~/.config/opencode/opencode.json",
      "setup_script": "setup_opencode.ps1"
    },
    "kimi": {
      "instructions": "AGENTS.md",
      "global_skills": "~/.kimi-code/skills",
      "kimi_home": "~/.kimi-code",
      "plugin_source": "adapters/kimi/ts800x-workflow",
      "plugin_id": "ts800x-workflow",
      "session_start_skill": "using-ts800x-workflow",
      "generator": "update_kimi_plugin.ps1",
      "setup_script": "setup_kimi.ps1"
    }
  },
