    ],
    "coding-standard": [
      "ts800x-coding-standard"
    ],
    "dependency-analyzer": [
      "ts800x-dependency-analyzer"
    ],
    "engineering-ops": [
      "ts800x-engineering-ops"
    ],
    "faq": [
      "ts800x-faq"
    ],
    "final-reviewer": [
      "ts800x-final-reviewer"
    ],
    "flash": [
      "ts800x-flash"
    ],
